# Local target data, databases, and generated recon output.
# The whole data/ and targets/ trees are user state: never tracked, so `git pull` never
# overwrites your scans or project configs. Restore a backup by copying data/ back in place.
/data/
/targets/

# Credentials
.env
.env.*
*.env
secrets.json
credentials.json

# Node / OS / IDE
node_modules/
npm-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
desktop.ini
.vscode/settings.json
.idea/

# Tool droppings (ProjectDiscovery resume file, gowitness db/report); root-anchored so
# src/recon/tools/builtin/gowitness.json stays tracked.
resume.cfg
/gowitness.*
