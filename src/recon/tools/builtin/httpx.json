{
  "tool_id": "httpx",
  "type": "cli",
  "phase": "http_probing",
  "binary": "httpx",
  "version_check": {
    "command": "httpx",
    "args": ["-version"]
  },
  "capability_check": {
    "command": "httpx",
    "args": ["-h"],
    "expected_output": "projectdiscovery|tech-detect|status-code|json"
  },
  "input_type": "domain_list",
  "output_format": "jsonl",
  "output_path": "stdout",
  "rate_limit_profile": "default_active_light",
  "parser": "httpx_jsonl",
  "tags": ["active", "http", "technology"],
  "install": {
    "method": "go_install",
    "source": "github.com/projectdiscovery/httpx/cmd/httpx@latest"
  },
  "safety": {
    "requires_authorization": true,
    "active_network": true,
    "default_profile": "standard"
  }
}
