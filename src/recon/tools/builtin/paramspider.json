{
  "tool_id": "paramspider",
  "type": "cli",
  "phase": "param_mining",
  "binary": "paramspider",
  "version_check": { "command": "paramspider", "args": ["-h"] },
  "input_type": "domain_list",
  "output_format": "text",
  "output_path": "file",
  "rate_limit_profile": "default_passive",
  "parser": "url_lines",
  "tags": ["passive", "param", "url", "archive"],
  "install": {
    "method": "shell",
    "source": "command -v uv >/dev/null 2>&1 || curl -LsSf https://astral.sh/uv/install.sh | sh; uv tool install --force git+https://github.com/devanshbatham/ParamSpider"
  },
  "safety": {
    "requires_authorization": false,
    "active_network": true,
    "default_profile": "passive"
  }
}
