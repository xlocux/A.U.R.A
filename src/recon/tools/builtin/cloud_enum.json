{
  "tool_id": "cloud_enum",
  "type": "cli",
  "phase": "cloud_resource_discovery",
  "binary": "cloud_enum",
  "version_check": { "command": "cloud_enum", "args": ["--help"] },
  "capability_check": { "command": "cloud_enum", "args": ["--help"], "expected_output": "keyword" },
  "input_type": "keyword_list",
  "output_format": "json",
  "output_path": "file",
  "rate_limit_profile": "default_passive",
  "parser": "cloud_enum_json",
  "tags": ["passive", "cloud", "osint"],
  "install": {
    "method": "shell",
    "source": "command -v uv >/dev/null 2>&1 || curl -LsSf https://astral.sh/uv/install.sh | sh; uv tool install --force git+https://github.com/initstring/cloud_enum"
  },
  "safety": {
    "requires_authorization": false,
    "active_network": true,
    "default_profile": "passive"
  }
}
