{
  "tool_id": "nuclei",
  "type": "cli",
  "phase": "vulnerability_assessment",
  "binary": "nuclei",
  "version_check": { "command": "nuclei", "args": ["-version"] },
  "capability_check": { "command": "nuclei", "args": ["-version"], "expected_output": "nuclei|projectdiscovery|templates" },
  "input_type": "url_list",
  "output_format": "jsonl",
  "output_path": "stdout",
  "rate_limit_profile": "default_active_conservative",
  "parser": "nuclei_jsonl",
  "tags": ["active", "vuln"],
  "install": {
    "method": "shell",
    "source": "command -v go >/dev/null 2>&1 || (sudo apt-get update && sudo apt-get install -y golang-go git); go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest"
  },
  "safety": {
    "requires_authorization": true,
    "active_network": true,
    "default_profile": "full"
  }
}
